#!/bin/bash
set -euo pipefail

# Apply dotfile changes (handles symlink additions/removals)
chezmoi apply

# Skip stack management if .env is not yet configured
if [ ! -f "$HOME/homelab/.env" ]; then
    echo "No .env file found at ~/homelab/.env — skipping stack management"
    exit 0
fi

# Pick up symlink changes in systemd
systemctl --user daemon-reload

# Stop stacks that are running but no longer enabled
while IFS= read -r svc; do
    if ! systemctl --user is-enabled --quiet "$svc" 2>/dev/null; then
        systemctl --user stop "$svc"
    fi
done < <(systemctl --user list-units --state=active --no-legend 'docker-compose@*.service' | awk '{print $1}')

# Reload running stacks
systemctl --user reload docker-compose@*.service || true

# Start newly enabled stacks. `systemctl start` with a glob only matches
# units systemd has already loaded (i.e. started at least once), so a
# never-before-started unit silently gets skipped by a glob -- and
# `list-unit-files` only knows the docker-compose@.service template itself,
# not its instances, so it can't enumerate them either. The instances that
# are actually enabled are exactly the default.target.wants/ symlinks, so
# read the names from there and start each by name instead.
for svc in "$HOME/.config/systemd/user/default.target.wants/"docker-compose@*.service; do
    [ -L "$svc" ] || continue
    systemctl --user start "$(basename "$svc")"
done
