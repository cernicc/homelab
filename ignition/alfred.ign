{
  "ignition": {
    "version": "3.4.0"
  },
  "passwd": {
    "users": [
      {
        "groups": [
          "wheel"
        ],
        "homeDir": "/home/cernic",
        "name": "cernic",
        "sshAuthorizedKeys": [
          "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIObOsA5oUCSLkwXE15Fdxf0BD2hQMGMCbdnDW1oZHshV lightweight-machine"
        ],
        "shell": "/bin/bash"
      }
    ]
  },
  "storage": {
    "directories": [
      {
        "path": "/etc/ucore-autorebase",
        "mode": 493
      },
      {
        "path": "/etc/ssh/sshd_config.d",
        "mode": 493
      },
      {
        "path": "/etc/containers",
        "mode": 493
      },
      {
        "path": "/etc/pki/containers",
        "mode": 493
      },
      {
        "path": "/etc/containers/registries.d",
        "mode": 493
      }
    ],
    "files": [
      {
        "path": "/etc/hostname",
        "contents": {
          "compression": "",
          "source": "data:,alfred"
        },
        "mode": 420
      },
      {
        "path": "/etc/ssh/sshd_config.d/99-hardening.conf",
        "contents": {
          "compression": "",
          "source": "data:,PasswordAuthentication%20no%0APermitRootLogin%20no%0AAllowUsers%20cernic%0AX11Forwarding%20no%0AMaxAuthTries%203%0A"
        },
        "mode": 384
      },
      {
        "path": "/etc/pki/containers/cernicc-homelab.pub",
        "contents": {
          "compression": "",
          "source": "data:,-----BEGIN%20PUBLIC%20KEY-----%0AMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEjk7pDi62rWPH30Gq18vuu1mqqU6z%0AHZ98WNJTTiBnmR7pqGRvddWH3xL5Dzi7uYFiwiMn8KzxolrvPHj3aWsx%2Bw%3D%3D%0A-----END%20PUBLIC%20KEY-----%0A"
        },
        "mode": 420
      },
      {
        "overwrite": true,
        "path": "/etc/containers/policy.json",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 420
      },
      {
        "path": "/etc/containers/registries.d/default.yaml",
        "contents": {
          "compression": "",
          "source": "data:,docker%3A%0A%20%20ghcr.io%2Fcernicc%2Fucore-server%3A%0A%20%20%20%20use-sigstore-attachments%3A%20true%0A"
        },
        "mode": 420
      }
    ],
    "filesystems": [
      {
        "device": "/dev/mapper/root",
        "format": "xfs",
        "label": "root",
        "wipeFilesystem": true
      }
    ],
    "links": [
      {
        "path": "/etc/localtime",
        "target": "../usr/share/zoneinfo/Europe/Ljubljana"
      }
    ],
    "luks": [
      {
        "clevis": {
          "tpm2": true
        },
        "device": "/dev/disk/by-partlabel/root",
        "label": "luks-root",
        "name": "root",
        "wipeVolume": true
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "enabled": true,
        "name": "sshd.service"
      },
      {
        "enabled": true,
        "name": "tailscaled.service"
      },
      {
        "enabled": true,
        "name": "incus.service"
      },
      {
        "dropins": [
          {
            "contents": "[Timer]\nOnBootSec=\nOnUnitInactiveSec=\nRandomizedDelaySec=\nOnCalendar=*-*-* 01:00:00 UTC\nRandomizedDelaySec=30m\nPersistent=true\n",
            "name": "schedule.conf"
          }
        ],
        "enabled": true,
        "name": "bootc-fetch-apply-updates.timer"
      },
      {
        "contents": "[Unit]\nDescription=Configure firewall rules for homelab\nConditionPathExists=/etc/ucore-autorebase/signed\nAfter=network-online.target tailscaled.service incus.service ucore-signed-autorebase.service\nWants=network-online.target tailscaled.service incus.service\n[Service]\nType=oneshot\nRemainAfterExit=yes\nStandardOutput=journal+console\nStandardError=journal+console\nExecStart=-/usr/bin/firewall-cmd --new-zone=tailscale --permanent\nExecStart=-/usr/bin/firewall-cmd --zone=tailscale --add-interface=tailscale0 --permanent\nExecStart=-/usr/bin/firewall-cmd --zone=tailscale --add-port=80/tcp --permanent\nExecStart=-/usr/bin/firewall-cmd --zone=tailscale --add-port=443/tcp --permanent\nExecStart=-/usr/bin/firewall-cmd --zone=tailscale --add-service=ssh --permanent\nExecStart=-/usr/bin/firewall-cmd --zone=trusted --change-interface=incusbr --permanent\nExecStart=-/usr/bin/firewall-cmd --add-service=ssh --permanent\nExecStart=-/usr/bin/firewall-cmd --add-port=80/tcp --permanent\nExecStart=-/usr/bin/firewall-cmd --add-port=443/tcp --permanent\nExecStart=/usr/bin/firewall-cmd --reload\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "homelab-firewall.service"
      },
      {
        "contents": "[Unit]\nDescription=uCore autorebase to unsigned OCI and reboot\nConditionPathExists=!/etc/ucore-autorebase/unverified\nConditionPathExists=!/etc/ucore-autorebase/signed\nAfter=network-online.target\nWants=network-online.target\n[Service]\nType=oneshot\nRestart=on-failure\nRestartSec=30\nTimeoutStartSec=infinity\nStandardOutput=journal+console\nStandardError=journal+console\nExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/cernicc/ucore-server:latest\nExecStart=/usr/bin/touch /etc/ucore-autorebase/unverified\nExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service\nExecStart=/usr/bin/systemctl reboot\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "ucore-unsigned-autorebase.service"
      },
      {
        "contents": "[Unit]\nDescription=uCore autorebase to signed OCI via bootc and reboot\nConditionPathExists=/etc/ucore-autorebase/unverified\nConditionPathExists=!/etc/ucore-autorebase/signed\nAfter=network-online.target ucore-unsigned-autorebase.service\nWants=network-online.target\n[Service]\nType=oneshot\nRestart=on-failure\nRestartSec=30\nTimeoutStartSec=infinity\nStandardOutput=journal+console\nStandardError=journal+console\nExecStart=/usr/bin/bootc switch --enforce-container-sigpolicy ghcr.io/cernicc/ucore-server:latest\nExecStart=/usr/bin/touch /etc/ucore-autorebase/signed\nExecStart=/usr/bin/systemctl disable ucore-signed-autorebase.service\nExecStart=/usr/bin/systemctl reboot\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "ucore-signed-autorebase.service"
      },
      {
        "contents": "[Unit]\nDescription=Bootstrap homelab dotfiles via chezmoi\nConditionPathExists=/etc/ucore-autorebase/signed\nConditionPathExists=!/etc/ucore-autorebase/bootstrapped\nAfter=network-online.target ucore-signed-autorebase.service\nWants=network-online.target\n[Service]\nType=oneshot\nRestart=on-failure\nRestartSec=30\nTimeoutStartSec=infinity\nStandardOutput=journal+console\nStandardError=journal+console\nExecStart=/usr/sbin/loginctl enable-linger cernic\nExecStart=/usr/bin/runuser -l cernic -c '/usr/bin/chezmoi init --apply https://github.com/cernicc/homelab'\nExecStart=/usr/bin/touch /etc/ucore-autorebase/bootstrapped\nExecStart=/usr/bin/systemctl disable homelab-bootstrap.service\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "homelab-bootstrap.service"
      }
    ]
  }
}
