{
  "ignition": {
    "version": "3.6.0"
  },
  "passwd": {
    "users": [
      {
        "groups": [
          "wheel"
        ],
        "homeDir": "/home/cernic",
        "name": "cernic",
        "sshAuthorizedKeys": [
          "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINMQ0ZTKjB40zWkigNsC9dFF1oZQmvgrKTH9JlHzVptK batman"
        ],
        "shell": "/bin/bash"
      }
    ]
  },
  "storage": {
    "directories": [
      {
        "path": "/etc/containers",
        "mode": 493
      },
      {
        "path": "/etc/pki/containers",
        "mode": 493
      },
      {
        "path": "/etc/containers/registries.d",
        "mode": 493
      }
    ],
    "files": [
      {
        "path": "/etc/hostname",
        "contents": {
          "compression": "",
          "source": "data:,alfred"
        },
        "mode": 420
      },
      {
        "path": "/etc/pki/containers/cernicc-homelab.pub",
        "contents": {
          "compression": "",
          "source": "data:,-----BEGIN%20PUBLIC%20KEY-----%0AMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEjk7pDi62rWPH30Gq18vuu1mqqU6z%0AHZ98WNJTTiBnmR7pqGRvddWH3xL5Dzi7uYFiwiMn8KzxolrvPHj3aWsx%2Bw%3D%3D%0A-----END%20PUBLIC%20KEY-----%0A"
        },
        "mode": 420
      },
      {
        "path": "/etc/sudoers.d/wheel-nopasswd",
        "contents": {
          "compression": "",
          "source": "data:,%25wheel%20ALL%3D(ALL)%20NOPASSWD%3A%20ALL%0A"
        },
        "mode": 288
      },
      {
        "overwrite": true,
        "path": "/etc/containers/policy.json",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 420
      },
      {
        "overwrite": true,
        "path": "/etc/containers/registries.d/default.yaml",
        "contents": {
          "compression": "",
          "source": "data:,docker%3A%0A%20%20ghcr.io%2Fcernicc%2Fucore-server%3A%0A%20%20%20%20use-sigstore-attachments%3A%20true%0A"
        },
        "mode": 420
      }
    ],
    "filesystems": [
      {
        "device": "/dev/mapper/root",
        "format": "xfs",
        "label": "root",
        "wipeFilesystem": true
      }
    ],
    "luks": [
      {
        "clevis": {
          "tpm2": true
        },
        "device": "/dev/disk/by-partlabel/root",
        "label": "luks-root",
        "name": "root",
        "wipeVolume": true
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "contents": "[Unit]\nDescription=uCore autorebase to unsigned OCI and reboot\nConditionPathExists=!/etc/ucore-autorebase/unverified\nConditionPathExists=!/etc/ucore-autorebase/signed\nAfter=network-online.target\nWants=network-online.target\n[Service]\nType=oneshot\nRestart=on-failure\nRestartSec=30\nTimeoutStartSec=infinity\nStandardOutput=journal+console\nStandardError=journal+console\nExecStartPre=/usr/bin/mkdir -p /etc/ucore-autorebase\nExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/cernicc/ucore-server:latest\nExecStart=/usr/bin/touch /etc/ucore-autorebase/unverified\nExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service\nExecStart=/usr/bin/systemctl reboot\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "ucore-unsigned-autorebase.service"
      },
      {
        "contents": "[Unit]\nDescription=uCore autorebase to signed OCI via bootc and reboot\nConditionPathExists=/etc/ucore-autorebase/unverified\nConditionPathExists=!/etc/ucore-autorebase/signed\nAfter=network-online.target ucore-unsigned-autorebase.service\nWants=network-online.target\n[Service]\nType=oneshot\nRestart=on-failure\nRestartSec=30\nTimeoutStartSec=infinity\nStandardOutput=journal+console\nStandardError=journal+console\nExecStart=/usr/bin/bootc switch --enforce-container-sigpolicy ghcr.io/cernicc/ucore-server:latest\nExecStart=/usr/bin/touch /etc/ucore-autorebase/signed\nExecStart=/usr/bin/systemctl disable ucore-signed-autorebase.service\nExecStart=/usr/bin/systemctl reboot\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "ucore-signed-autorebase.service"
      }
    ]
  }
}
