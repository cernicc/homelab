# Tailscale auth key -- Settings -> Keys in the admin console, reusable and
# tagged tag:homelab (see stacks/whoami/README.md). Used by every <service>-ts
# sidecar container to register itself on the tailnet.
TS_AUTHKEY=

# Tailscale auth key for dev VMs -- reusable, not ephemeral, tagged tag:dev
# (see incus/README.md). Must be a different key from TS_AUTHKEY.
TS_DEV_AUTHKEY=

# Media -- Grimmory's MariaDB
GRIMMORY_DB_PASSWORD=changeme
GRIMMORY_DB_ROOT_PASSWORD=changeme

# AI -- LibreChat and agentgateway (see stacks/ai/README.md)
LIBRECHAT_DOMAIN=https://chat.<tailnet-name>.ts.net
# OpenCode Go API key (opencode.ai, Go subscription); only agentgateway sees it
OPENCODE_API_KEY=
# LibreChat's key for agentgateway: openssl rand -hex 32
AGENTGATEWAY_LIBRECHAT_API_KEY=
# openssl rand -hex 32 (CREDS_IV: openssl rand -hex 16)
LIBRECHAT_CREDS_KEY=
LIBRECHAT_CREDS_IV=
LIBRECHAT_JWT_SECRET=
LIBRECHAT_JWT_REFRESH_SECRET=
LIBRECHAT_MEILI_MASTER_KEY=
