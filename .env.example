# Tailscale OAuth client -- Settings -> OAuth clients in the admin console,
# scoped to "Devices: Write" and restricted to a tag it owns (tag:homelab-container).
# Used by every <service>-ts sidecar container to register itself on the tailnet.
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=

# Transmission web UI credentials
TRANSMISSION_USER=admin
TRANSMISSION_PASS=changeme

# Ai
OPENCODE_GO_API_KEY=
API_SERVER_KEY=changeme-any-string-16-chars-plus
HERMES_WEBUI_PASSWORD=changeme

# Invoice Ninja
APP_ENV=production
APP_KEY=
# No ingress configured currently -- set this once invoices is reachable again
APP_URL=
DB_DATABASE=invoiceninja
DB_USERNAME=invoiceninja
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme
