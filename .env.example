# Tailscale auth key -- Settings -> Keys in the admin console, reusable and
# tagged tag:homelab (see stacks/whoami/README.md). Used by every <service>-ts
# sidecar container to register itself on the tailnet.
TS_AUTHKEY=

# Ai
OPENCODE_GO_API_KEY=
API_SERVER_KEY=changeme-any-string-16-chars-plus
HERMES_WEBUI_PASSWORD=changeme

# Invoice Ninja
APP_ENV=production
APP_KEY=
# No ingress configured currently -- set this once invoices is reachable again
APP_URL=
DB_DATABASE=invoiceninja
DB_USERNAME=invoiceninja
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme
