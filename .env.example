# Tailscale auth key -- Settings -> Keys in the admin console, reusable and
# tagged tag:homelab (see stacks/whoami/README.md). Used by every <service>-ts
# sidecar container to register itself on the tailnet.
TS_AUTHKEY=

# Tailscale auth key for dev VMs -- reusable, not ephemeral, tagged tag:dev
# (see incus/README.md). Must be a different key from TS_AUTHKEY.
TS_DEV_AUTHKEY=

# Media -- Grimmory's MariaDB
GRIMMORY_DB_PASSWORD=changeme
GRIMMORY_DB_ROOT_PASSWORD=changeme
