[Unit]
Description=Bootstrap homelab dotfiles via chezmoi
ConditionPathExists=!/etc/ucore-autorebase/bootstrapped
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
Restart=on-failure
RestartSec=30
TimeoutStartSec=infinity
StandardOutput=journal+console
StandardError=journal+console
ExecStartPre=/usr/bin/mkdir -p /etc/ucore-autorebase
ExecStart=/usr/sbin/loginctl enable-linger cernic
ExecStart=/usr/bin/runuser -l cernic -c '/usr/bin/chezmoi init --apply https://github.com/cernicc/homelab'
ExecStart=/usr/bin/touch /etc/ucore-autorebase/bootstrapped
ExecStart=/usr/bin/systemctl disable homelab-bootstrap.service
[Install]
WantedBy=multi-user.target
